# ==============================================================================
# 🔧 Neo Cloud Bites - Frontend Environment Variables (DEV)
# Copy this file to .env and fill in actual values
# ==============================================================================

# ── API URLs ─────────────────────────────────────────────────────────────
# Public URL (used by browser for client-side calls)
NEXT_PUBLIC_API_URL="https://dev.api.neocloudbites.com"
# Internal URL (used by Next.js server-side rewrites — stays on localhost)
BACKEND_INTERNAL_URL="http://127.0.0.1:5000"

# ── Database (same as backend, needed if frontend uses Prisma directly) ──
DATABASE_URL="postgresql://neocloudbites_user:NeoCloudBitesSecure2026!@127.0.0.1:5432/neocloudbites_dev_db"

# ── Authentication ───────────────────────────────────────────────────────
AUTH_SECRET="CHANGE_ME_same_as_backend"
NEXTAUTH_SECRET="CHANGE_ME_same_as_backend"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://dev.neocloudbites.com"

# ── Google Maps ──────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_key"

# ── Storage (if frontend needs it) ───────────────────────────────────────
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
