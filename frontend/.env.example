# ==============================================================================
# 🔧 Neo Cloud Bites - Frontend Environment Variables
# Copy this file to .env and fill in actual values
# ==============================================================================

# ── API URLs ─────────────────────────────────────────────────────────────
# Public URL (used by browser for client-side calls)
NEXT_PUBLIC_API_URL="https://dev.api.neocloudbites.com"
# Internal URL (used by Next.js server-side rewrites)
BACKEND_INTERNAL_URL="http://127.0.0.1:3001"

# ── Authentication ───────────────────────────────────────────────────────
AUTH_SECRET="GENERATE_A_RANDOM_SECRET_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_SECRET="GENERATE_A_RANDOM_SECRET_WITH_OPENSSL_RAND_BASE64_32"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://dev.neocloudbites.com"

# ── Google Maps ──────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_key"

# ── Storage (optional) ───────────────────────────────────────────────────
STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
