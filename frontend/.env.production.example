# ==============================================================================
# 🚀 Neo Cloud Bites - Frontend Production Environment Variables
# Targets: neocloudbites.com (Frontend) & api.neocloudbites.com (API)
# Copy this file to frontend/.env on your server and update the values
# ==============================================================================

# ── API URLs ─────────────────────────────────────────────────────────────
# Public URL used in browser client-side calls
NEXT_PUBLIC_API_URL="https://api.neocloudbites.com"

# Internal URL used by Next.js server-side rewrites & SSR (PM2 Backend on port 3001)
BACKEND_INTERNAL_URL="http://127.0.0.1:3001"

# ── Authentication ───────────────────────────────────────────────────────
AUTH_SECRET="REPLACE_WITH_SAME_AUTH_SECRET_AS_BACKEND"
NEXTAUTH_SECRET="REPLACE_WITH_SAME_NEXTAUTH_SECRET_AS_BACKEND"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://neocloudbites.com"

# ── Google Maps ──────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_key"
