# ==============================================================================
# 🚀 Neo Cloud Bites - Backend Production Environment Variables
# Targets: api.neocloudbites.com (API) & neocloudbites.com (Frontend)
# Copy this file to backend/.env on your server and update the values
# ==============================================================================

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL="postgresql://neocloudbites_user:NeoCloudBitesSecure2026!@127.0.0.1:5432/neocloudbites_db"

# ── Authentication ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_GENERATED_SECRET_32_CHARS"
NEXTAUTH_SECRET="REPLACE_WITH_GENERATED_SECRET_32_CHARS"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://api.neocloudbites.com"

# ── Storage Configuration ─────────────────────────────────────────────────
STORAGE_PROVIDER="local"
UPLOAD_BASE_URL="https://api.neocloudbites.com"

# ── Razorpay ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_live_your_key"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# ── Google Maps ──────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY="your_google_maps_key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_key"

# ── Account Deletion Settings ─────────────────────────────────────────────
ACCOUNT_DELETION_DAYS=30
ACCOUNT_DELETION_HOURS=0
ACCOUNT_DELETION_MINUTES=0
ACCOUNT_DELETION_CRON_HOUR=3
ACCOUNT_DELETION_CRON_MINUTE=0

# ── SMTP Email Notifications (Zoho ZeptoMail) ─────────────────────────────
SMTP_HOST="smtp.zeptomail.in"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="emailapikey"
SMTP_PASSWORD="YOUR_ZEPTOMAIL_PASSWORD_TOKEN"
SMTP_FROM_EMAIL="noreply@neocloudbites.com"
SMTP_FROM_NAME="Neocloudbites"
ADMIN_NOTIFICATION_EMAIL="admin@neocloudbites.com"

# ── SMS Gateway ───────────────────────────────────────────────────────────
SMS_GATEWAY_URL="https://platform.way2smart.in/index.php/sms/urlsms"
SMS_API_KEY="your_sms_api_key"
SMS_SENDER="NEOPCE"
SMS_DLT_ENTITY_ID="your_dlt_entity_id"
SMS_DLT_TEMPLATE_ID="your_dlt_template_id"
SMS_APP_HASH="your_app_hash"
SMS_TEMPLATE="Dear Customer your Otp for login is {OTP} . This code will expire in 10 minutes ."
ALLOW_MASTER_OTP="false"

# ── Tracking & Public Domain ─────────────────────────────────────────────
TRACKING_DOMAIN="https://neocloudbites.com"
FRONTEND_URL="https://neocloudbites.com"
