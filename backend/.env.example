# ==============================================================================
# 🔧 Neo Cloud Bites - Backend Environment Variables
# Copy this file to .env and fill in actual values
# ==============================================================================

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/neocloudbites_db"

# ── Authentication ───────────────────────────────────────────────────────
AUTH_SECRET="GENERATE_A_RANDOM_SECRET_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_SECRET="GENERATE_A_RANDOM_SECRET_WITH_OPENSSL_RAND_BASE64_32"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://dev.api.neocloudbites.com"

# ── Storage Configuration ─────────────────────────────────────────────────
# Options: "local" (store files on the backend server) | "cloudinary" | "s3"
STORAGE_PROVIDER="local"

# When STORAGE_PROVIDER=local, files are stored in backend/public/uploads/{folder}/
UPLOAD_BASE_URL="http://localhost:5000"

# Cloudinary configuration (used when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── Razorpay ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_your_key"
RAZORPAY_KEY_SECRET="your_secret"

# ── Google Maps ──────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY="your_google_maps_key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_key"

# ── Account Deletion Settings ─────────────────────────────────────────────
ACCOUNT_DELETION_DAYS=30
ACCOUNT_DELETION_HOURS=0
ACCOUNT_DELETION_MINUTES=0
ACCOUNT_DELETION_CRON_HOUR=3
ACCOUNT_DELETION_CRON_MINUTE=0

# ── SMTP Email Notifications ──────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="notifications@example.com"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM="\"Neo Cloud Bites\" <notifications@example.com>"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# ── SMS Gateway ───────────────────────────────────────────────────────────
SMS_GATEWAY_URL="https://platform.way2smart.in/index.php/sms/urlsms"
SMS_API_KEY="your_sms_api_key"
SMS_SENDER="NEOPCE"
SMS_DLT_ENTITY_ID="your_dlt_entity_id"
SMS_DLT_TEMPLATE_ID="your_dlt_template_id"
SMS_APP_HASH="your_app_hash"
SMS_TEMPLATE="Dear Customer your Otp for login is {OTP} . This code will expire in 10 minutes ."
ALLOW_MASTER_OTP="false"

# ── Tracking & Public Domain ─────────────────────────────────────────────
TRACKING_DOMAIN="https://dev.neocloudbites.com"
FRONTEND_URL="https://dev.neocloudbites.com"
