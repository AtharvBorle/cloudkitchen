# ==============================================================================
# 🔧 Neo Cloud Bites - Backend Environment Variables (DEV)
# Copy this file to .env and fill in actual values
# ==============================================================================

# ── Database (Local PostgreSQL) ──────────────────────────────────────────
DATABASE_URL="postgresql://neocloudbites_user:NeoCloudBitesSecure2026!@127.0.0.1:5432/neocloudbites_dev_db"

# ── Authentication ───────────────────────────────────────────────────────
AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
NEXTAUTH_SECRET="CHANGE_ME_same_as_AUTH_SECRET"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://dev.api.neocloudbites.com"

# ── Storage (Cloudinary) ─────────────────────────────────────────────────
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Razorpay ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_your_key"
RAZORPAY_KEY_SECRET="your_secret"

# ── Google Maps ──────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_key"
