generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  passwordHash    String
  role            String          @default("USER")
  name            String
  phone           String
  city            String
  pincode         String
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  addresses       Address[]
  agentProfile    AgentProfile?
  bookings        Booking[]
  deliveryProfile DeliveryPerson?
  orders          Order[]
  refunds         Refund[]
  reviews         Review[]
  sellerProfile   SellerProfile?
  tickets         Ticket[]        @relation("UserTickets")
  messagesSent    TicketMessage[] @relation("SenderMessages")
  userMealSubscriptions UserMealSubscription[]
}

model SellerProfile {
  id                         String           @id @default(uuid())
  userId                     String           @unique
  type                       String
  businessName               String           @default("")
  addressFlat                String           @default("")
  addressLocality            String           @default("")
  addressLandmark            String?
  kitchenImages              String           @default("[]")
  cuisineImages              String           @default("[]")
  bannerImageUrl             String?
  adhaarUrl                  String
  fssaiUrl                   String?
  verificationStatus         String           @default("PENDING")
  verificationNote           String?
  trackingId                 String           @unique
  upiId                      String?
  isOnline                   Boolean          @default(true)
  agentId                    String?
  businessCategory           String           @default("FOOD")
  foodType                   String           @default("BOTH")
  lightBillUrl               String?
  passbookUrl                String?
  roomImages                 String           @default("[]")
  foodVerificationStatus     String           @default("NONE")
  propertyVerificationStatus String           @default("NONE")
  deliveryPersons            DeliveryPerson[]
  foodItems                  FoodItem[]
  orders                     Order[]
  reviews                    Review[]
  rooms                      Room[]
  agent                      AgentProfile?    @relation(fields: [agentId], references: [id])
  user                       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  servedPincodes             ServedPincode[]
  subscriptions              Subscription[]
  mealPlans                  SellerMealPlan[]
  userMealSubscriptions      UserMealSubscription[]
}

model ServedPincode {
  id       String        @id @default(uuid())
  sellerId String
  pincode  String
  name     String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, pincode])
}

model AgentProfile {
  id               String          @id @default(uuid())
  userId           String          @unique
  canManageOffers  Boolean         @default(false)
  canManageBanners Boolean         @default(false)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedSellers  SellerProfile[]
}

model Category {
  id             String         @id @default(uuid())
  name           String
  type           String
  foodItems      FoodItem[]
  foodCategories FoodCategory[] @relation("CategoryToFoodCategory")
}

model FoodCategory {
  id            String            @id @default(uuid())
  name          String
  imageUrl      String?
  foodItems     FoodItem[]
  subCategories FoodSubCategory[]
  categories    Category[]        @relation("CategoryToFoodCategory")
}

model FoodSubCategory {
  id             String       @id @default(uuid())
  name           String
  foodCategoryId String
  imageUrl       String?
  foodItems      FoodItem[]
  foodCategory   FoodCategory @relation(fields: [foodCategoryId], references: [id], onDelete: Cascade)
}

model FoodItem {
  id                String           @id @default(uuid())
  sellerId          String
  name              String
  description       String
  price             Float
  imageUrl          String?
  availableDays     String           @default("Mon,Tue,Wed,Thu,Fri,Sat,Sun")
  isAvailable       Boolean          @default(true)
  stockQuantity     Int              @default(-1)
  categoryId        String?
  deliveryPincodes  String?
  closeTime         String?
  openTime          String?
  operationalHours  String?
  itemType          String           @default("VEG")
  variants          String?          @default("[]")
  foodCategoryId    String?
  foodSubCategoryId String?
  category          Category?        @relation(fields: [categoryId], references: [id])
  foodCategory      FoodCategory?    @relation(fields: [foodCategoryId], references: [id])
  foodSubCategory   FoodSubCategory? @relation(fields: [foodSubCategoryId], references: [id])
  seller            SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  itemRatings       ItemRating[]
}

model Order {
  id                   String                @id @default(uuid())
  userId               String
  sellerId             String
  status               String                @default("PENDING")
  items                String                @default("[]")
  deliveryAddress      String                @default("Pickup")
  customerPhone        String                @default("")
  paymentMethod        String
  totalAmount          Float
  isPaid               Boolean               @default(false)
  deliveryPersonId     String?
  razorpayOrderId      String?               @unique
  razorpayPaymentId    String?               @unique
  appliedCouponId      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deliveryTransactions DeliveryTransaction[]
  deliveryPerson       DeliveryPerson?       @relation(fields: [deliveryPersonId], references: [id])
  seller               SellerProfile         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  refund               Refund?
  review               Review?
}

model Room {
  id          String        @id @default(uuid())
  sellerId    String
  title       String        @default("Cozy Room")
  price       Float
  description String
  capacity    Int           @default(1)
  images      String        @default("[]")
  isAvailable Boolean       @default(true)
  bookings    Booking[]
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model Booking {
  id                String   @id @default(uuid())
  roomId            String
  userId            String
  startDate         DateTime
  endDate           DateTime
  status            String
  createdAt         DateTime @default(now())
  isPaid            Boolean  @default(false)
  paymentMethod     String   @default("COD")
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?  @unique
  totalAmount       Float    @default(0)
  room              Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refund            Refund?
}

model SubscriptionPlan {
  id                  String               @id @default(uuid())
  name                String
  price               Float
  durationMonths      Int
  features            String               @default("[]")
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  category            String               @default("BOTH")
  subscriptions       Subscription[]
  subscriptionCoupons SubscriptionCoupon[]
}

model Subscription {
  id                String            @id @default(uuid())
  sellerId          String
  planId            String?
  status            String
  validUntil        DateTime
  amount            Float
  razorpayOrderId   String?           @unique
  razorpayPaymentId String?           @unique
  appliedCoupon     String?
  createdAt         DateTime          @default(now())
  plan              SubscriptionPlan? @relation(fields: [planId], references: [id])
  seller            SellerProfile     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model SubscriptionCoupon {
  id                 String            @id @default(uuid())
  code               String            @unique
  description        String            @default("")
  discountPercentage Float?
  discountAmount     Float?
  planId             String?
  maxUsage           Int               @default(0)
  currentUsage       Int               @default(0)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  category           String            @default("BOTH")
  plan               SubscriptionPlan? @relation(fields: [planId], references: [id])
}

model SellerMealPlan {
  id                 String                 @id @default(uuid())
  sellerId           String
  name               String
  tier               String                 @default("Bronze")
  description        String?                @default("")
  weeklyPrice        Float
  monthlyPrice       Float?
  quarterlyPrice     Float?
  yearlyPrice        Float?
  duration           String                 @default("1 Week")
  features           String                 @default("[]")
  mealTimings        String                 @default("[]")
  status             String                 @default("Live")
  allowCancel        Boolean                @default(true)
  pauseBillingPeriod String                 @default("Monthly")
  subscribersCount   Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  seller             SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userSubscriptions  UserMealSubscription[]
}

model UserMealSubscription {
  id                String         @id @default(uuid())
  userId            String
  sellerId          String
  planId            String
  status            String         @default("ACTIVE")
  tier              String         @default("Bronze")
  startDate         DateTime       @default(now())
  endDate           DateTime?
  pricePaid         Float          @default(0)
  cycle             String         @default("WEEKLY")
  isPaused          Boolean        @default(false)
  deliveryAddress   String?        @default("")
  contactPhone      String?        @default("")
  razorpayOrderId   String?        @unique
  razorpayPaymentId String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  plan              SellerMealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  seller            SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id        String   @id @default("GLOBAL")
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Coupon {
  id                 String    @id @default(uuid())
  code               String    @unique
  description        String    @default("")
  discountType       String    @default("PERCENTAGE")
  discountPercentage Float?
  discountAmount     Float?
  creatorId          String    @default("SYSTEM")
  appliesToSellerId  String?
  appliesToProductId String?
  appliesTo          String    @default("ALL")
  customerEligibility String   @default("ALL")
  usageLimit         Int?
  perUserLimit       Int?      @default(1)
  noExpiry           Boolean   @default(false)
  validFrom          DateTime  @default(now())
  validUntil         DateTime?
  maxUsagesPerUser   Int?
  maxUsers           Int?
  currentUsersCount  Int       @default(0)
  minimumCartValue   Float?
  maxDiscountAmount  Float?
  isActive           Boolean   @default(true)
  approvalStatus     String    @default("APPROVED")
  adminNote          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  category           String    @default("BOTH")
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  performedBy String
  details     String
  timestamp   DateTime @default(now())
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  type        String
  houseNumber String
  street      String
  landmark    String?
  pincode     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  latitude    Float?
  longitude   Float?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PopupBanner {
  id                String   @id @default(uuid())
  title             String
  imageUrl          String
  redirectUrl       String?
  appliesToSellerId String?
  isActive          Boolean  @default(true)
  approvalStatus    String   @default("APPROVED")
  adminNote         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model HomePromoBanner {
  id              String   @id @default(uuid())
  title           String
  desktopImageUrl String
  mobileImageUrl  String?
  redirectUrl     String?  @default("/explore-desktop")
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DeliveryPerson {
  id                 String                @id @default(uuid())
  userId             String                @unique
  name               String
  phone              String
  sellerId           String
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  outstandingBalance Float                 @default(0.0)
  seller             SellerProfile         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       DeliveryTransaction[]
  orders             Order[]
}

model Review {
  id          String        @id @default(uuid())
  orderId     String        @unique
  userId      String
  sellerId    String
  rating      Int
  comment     String?
  sellerReply String?
  repliedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  itemRatings ItemRating[]
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ItemRating {
  id         String   @id @default(uuid())
  reviewId   String
  foodItemId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Ticket {
  id          String          @id @default(uuid())
  userId      String
  title       String
  description String
  category    String
  status      String          @default("OPEN")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  messages    TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  senderId  String
  message   String
  createdAt DateTime @default(now())
  sender    User     @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Refund {
  id            String   @id @default(uuid())
  userId        String
  orderId       String?  @unique
  bookingId     String?  @unique
  amount        Float
  reason        String
  status        String   @default("PENDING")
  transactionId String?
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  booking       Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeliveryTransaction {
  id               String         @id @default(uuid())
  deliveryPersonId String
  type             String
  amount           Float
  orderId          String?
  description      String?
  status           String         @default("COMPLETED")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deliveryPerson   DeliveryPerson @relation(fields: [deliveryPersonId], references: [id], onDelete: Cascade)
  order            Order?         @relation(fields: [orderId], references: [id])
}
